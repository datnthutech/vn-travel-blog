---
// Bài liên quan (cùng tỉnh / cùng chuyên mục) — giúp link nội bộ cho SEO. Không có bài nào thì không hiện.
import { urlBai, type BaiViet } from '@vntraveltips/schema';
interface Props {
  bai: BaiViet[];
}
const { bai } = Astro.props;
---

{
  bai.length > 0 && (
    <section>
      <h2>Bài liên quan</h2>
      <ul>{bai.map((b) => <li><a href={urlBai(b)}>{b.tieuDe}</a></li>)}</ul>
    </section>
  )
}
