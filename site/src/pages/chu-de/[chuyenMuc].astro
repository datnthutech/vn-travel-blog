---
// Trang chuyên mục: /chu-de/[chuyen-muc]/ — chỉ tạo cho chuyên mục đã có bài.
import Base from '../../layouts/Base.astro';
import BaiCard from '../../components/BaiCard.astro';
import { layBaiViet } from '../../lib/bai';
import { layChuyenMuc } from '../../lib/chuyen-muc';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const bai = await layBaiViet();
  return layChuyenMuc()
    .map((cm) => ({ params: { chuyenMuc: cm.slug }, props: { cm, bai: bai.filter((b) => b.chuyenMuc.includes(cm.slug)) } }))
    .filter((p) => p.props.bai.length > 0);
}
const { cm, bai } = Astro.props;
const ten = cm.ten;
---

<Base title={`${ten} — ${SITE.ten}`} moTa={cm.moTa || `Các bài về ${ten.toLowerCase()} khi đi du lịch cùng bé nhỏ.`}>
  <h1>{ten}</h1>
  {bai.map((b) => <BaiCard bai={b} />)}
</Base>
