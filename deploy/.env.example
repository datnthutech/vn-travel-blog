# Mẫu biến môi trường cho deploy/.env (cạnh docker-compose.yml). Copy thành deploy/.env rồi điền giá trị thật.
# KHÔNG commit file .env thật (đã có trong .gitignore). Đường dẫn ảnh/site/dữ liệu do docker-compose.yml cố định.
PUBLIC_BASE_URL=https://vntraveltips.monai.click
PREVIEW_BASE_URL=https://nhap-vntraveltips.monai.click
GITHUB_REPO=<chu-so-huu>/<ten-repo>
# Fine-grained token: chỉ repo này, quyền Contents (read/write). Token không cần quyền nào khác.
GITHUB_TOKEN=
# Tài khoản GitHub duy nhất được đăng nhập
ALLOWED_GITHUB_USER=
# OAuth App của GitHub (dùng để đăng nhập MCP và /admin)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Chuỗi ngẫu nhiên dài, tạo bằng: openssl rand -hex 32
SESSION_SECRET=
# Bí mật của webhook GitHub (cùng giá trị điền trong cài đặt webhook của repo)
GITHUB_WEBHOOK_SECRET=
# Chặn Google lập chỉ mục toàn site (bật khi chưa sẵn sàng; gỡ bằng NOINDEX_ALL=false rồi ./deploy.sh — mcp tự build lại khi khởi động)
NOINDEX_ALL=true
# Mã GoatCounter (đếm lượt xem không cookie); để trống nếu chưa dùng
GOATCOUNTER_CODE=
