---
// Giới thiệu gia đình/tác giả — nội dung này chủ blog tự viết lại cho đúng thực tế.
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
---

<Base title="Giới thiệu — VNTravelTips" moTa={SITE.moTa}>
  <h1>Giới thiệu</h1>
  <p>
    VNTravelTips là nhật ký du lịch của một gia đình nhỏ có con nhỏ. Mỗi bài đặt thông tin tiện lợi
    lên trước — đi có tiện không, tốn bao nhiêu, cần lưu ý gì với bé — rồi mới kể chuyện.
  </p>
  <p>Mọi trải nghiệm trong blog đều do gia đình tự đi và tự trả tiền, trừ khi bài có ghi nhãn “Bài hợp tác”.</p>
</Base>
