---
// Thẻ SEO trong <head>: canonical, mô tả, Open Graph, Twitter card, JSON-LD.
// Trang nào có dữ liệu riêng (bài viết) truyền thêm moTa, anh, jsonLd; trang khác dùng mặc định của blog.
import { SITE } from '../config/site';
interface Props {
  ngonNgu?: string;
  /** mã ngôn ngữ → đường dẫn của CHÍNH trang này ở từng ngôn ngữ đã đăng (gồm cả trang hiện tại). ≥ 2 mục mới sinh hreflang. */
  hreflang?: Record<string, string>;
  title: string;
  moTa?: string;
  duongDan?: string;
  anh?: string;
  loai?: 'website' | 'article';
  jsonLd?: object[];
}
const { ngonNgu = 'vi', hreflang = {}, title, moTa = SITE.moTa, duongDan = Astro.url.pathname, anh, loai = 'website', jsonLd = [] } = Astro.props;
const LOCALE_OG: Record<string, string> = { vi: 'vi_VN', en: 'en_US' };
// Open Graph cần dạng ngôn_ngữ_QUỐC GIA: 'zh-cn' → zh_CN, 'fr' → fr_FR.
const ogLocale = (ma: string) => { const [a, b] = ma.split('-'); return `${a}_${(b ?? a).toUpperCase()}`; };
const canonical = new URL(duongDan, Astro.site).toString();
const anhMacDinh = SITE.anhChiaSe ? `/anh/${SITE.anhChiaSe.ma}/1600.webp` : undefined; // ảnh chia sẻ mặc định cho trang không có ảnh riêng
const anhChon = anh || anhMacDinh; // chuỗi rỗng cũng dùng ảnh mặc định
const anhOg = anhChon ? new URL(anhChon, Astro.site).toString() : undefined;
---

<meta name="description" content={moTa} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={SITE.ten} href={ngonNgu === 'vi' ? '/rss.xml' : `/${ngonNgu}/rss.xml`} />
{Object.keys(hreflang).length >= 2 && Object.entries(hreflang).map(([ma, url]) => <link rel="alternate" hreflang={ma} href={new URL(url, Astro.site).toString()} />)}
{Object.keys(hreflang).length >= 2 && hreflang.vi && <link rel="alternate" hreflang="x-default" href={new URL(hreflang.vi, Astro.site).toString()} />}
<meta property="og:site_name" content={SITE.ten} />
<meta property="og:type" content={loai} />
<meta property="og:title" content={title} />
<meta property="og:description" content={moTa} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={LOCALE_OG[ngonNgu] ?? ogLocale(ngonNgu)} />
{anhOg && <meta property="og:image" content={anhOg} />}
<meta name="twitter:card" content={anhOg ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={moTa} />
{anhOg && <meta name="twitter:image" content={anhOg} />}
{jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
