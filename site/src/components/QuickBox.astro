---
// Khung "Tra nhanh" — phần quan trọng nhất của bài: thông tin tiện lợi hiện trước, kể chuyện để sau.
// Các mục mở rộng dùng <details> của HTML nên bấm mở được mà không cần JavaScript.
// Khối nào không có dữ liệu thì không hiện (bài top-list/cẩm nang có thể không có traNhanh).
import type { BaiViet } from '@vntraveltips/schema';
import { sao } from '../lib/stars';
import DiaDiemDetails from './DiaDiemDetails.astro';
interface Props {
  bai: BaiViet;
}
const { bai } = Astro.props;
const t = bai.traNhanh;
const chiPhi = t ? new Intl.NumberFormat('vi-VN').format(t.tongChiPhi) + 'đ' : '';
const choO = bai.diaDiem.filter((d) => d.kieu === 'cho-o');
const anUong = bai.diaDiem.filter((d) => d.kieu === 'quan-an' || d.kieu === 'cho');
const khac = bai.diaDiem.filter((d) => d.kieu === 'khu-sinh-thai' || d.kieu === 'diem-choi');
---

{
  (t || bai.diaDiem.length > 0) && (
    <section class="tra-nhanh" aria-label="Tra nhanh">
      <h2>Tra nhanh</h2>
      {t && (
        <dl>
          <dt>Hợp với</dt><dd>{t.hopVoi}</dd>
          <dt>Thời gian</dt><dd>{t.thoiGian}</dd>
          {t.choO && (<><dt>Chỗ ở</dt><dd>{t.choO}</dd></>)}
          <dt>Tổng chi phí</dt><dd>{chiPhi} / {t.soNguoi} người</dd>
          <dt>Thân thiện với bé</dt><dd aria-label={`${t.diemThanThienVoiBe} trên 5 sao`}>{sao(t.diemThanThienVoiBe)}</dd>
          <dt>Di chuyển</dt><dd>{t.diChuyen}</dd>
          <dt>Thời điểm nên đi</dt><dd>{t.thoiDiemNenDi}</dd>
        </dl>
      )}
      {choO.length > 0 && (
        <details><summary>Chỗ ở chi tiết</summary><DiaDiemDetails diaDiem={choO} /></details>
      )}
      {anUong.length > 0 && (
        <details><summary>Chợ & quán ăn ({anUong.length})</summary><DiaDiemDetails diaDiem={anUong} /></details>
      )}
      {khac.length > 0 && (
        <details><summary>Điểm tham quan ({khac.length})</summary><DiaDiemDetails diaDiem={khac} /></details>
      )}
      {t && t.luuYVoiBe.length > 0 && (
        <details><summary>Lưu ý khi đi cùng bé</summary><ul>{t.luuYVoiBe.map((l) => <li>{l}</li>)}</ul></details>
      )}
    </section>
  )
}

<style>
  .tra-nhanh { background: #e8f6f5; border: 1px solid var(--vien); border-radius: 12px; padding: 12px 16px; margin: 16px 0; }
  .tra-nhanh h2 { margin: 0 0 8px; font-size: 1.1rem; color: var(--bien); }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 0 0 8px; }
  dt { font-weight: 600; }
  dd { margin: 0; }
  details { border-top: 1px solid var(--vien); padding: 8px 0; }
  summary { cursor: pointer; font-weight: 600; min-height: 32px; }
</style>
