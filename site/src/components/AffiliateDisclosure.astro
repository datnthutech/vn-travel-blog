---
// Dòng tiết lộ affiliate (ngắn) — hiện ở cuối bài khi bài có link kiếm hoa hồng. Dẫn tới trang chính sách.
import { t } from '../i18n/giao-dien';
interface Props { ngonNgu?: string }
const { ngonNgu = 'vi' } = Astro.props;
---

<p class="tiet-lo">
  {t(ngonNgu, 'tiet-lo-affiliate')}
  <a href="/chinh-sach-lien-ket/">{t(ngonNgu, 'xem-chinh-sach')}</a>.
</p>

<style>
  .tiet-lo { margin-top: 32px; padding: 10px 14px; font-size: 0.85rem; color: var(--chu); background: var(--nen-dam); border-radius: var(--bo); }
</style>
