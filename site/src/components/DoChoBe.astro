---
// "Đồ nên mang cho bé" — link (nếu có) là affiliate nên gắn rel="sponsored nofollow noopener".
import { REL_AFFILIATE } from '../lib/affiliate';
import { t } from '../i18n/giao-dien';
interface Props {
  doMang: { ten: string; ghiChu?: string; link?: string }[];
  ngonNgu?: string;
}
const { doMang, ngonNgu = 'vi' } = Astro.props;
---

{
  doMang.length > 0 && (
    <section class="the khoi">
      <h2>{t(ngonNgu, 'do-mang-cho-be')}</h2>
      <ul>
        {doMang.map((d) => (
          <li>
            {d.link ? <a href={d.link} rel={REL_AFFILIATE} target="_blank">{d.ten}</a> : d.ten}
            {d.ghiChu && <> — {d.ghiChu}</>}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .khoi { margin: 24px 0; padding: 16px; }
  h2 { margin: 0 0 8px; font-size: 1.2rem; }
</style>
