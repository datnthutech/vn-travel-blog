---
// Thẻ bài dùng ở mọi danh sách (trang chủ, tỉnh, chuyên mục, loại bài, bài liên quan).
// Cả thẻ là một link. Nhãn (tỉnh, điểm với bé, tổng chi phí) lấy từ nhanTheBai — không có dữ liệu thì không hiện dòng nhãn.
import { urlBai, type BaiViet } from '@vntraveltips/schema';
import Picture from './Picture.astro';
import { nhanTheBai } from '../lib/giao-dien-b';
interface Props {
  bai: BaiViet;
  ngonNgu?: string;
  tenTinh?: string;
  uuTien?: boolean;
}
const { bai, ngonNgu = 'vi', tenTinh, uuTien = false } = Astro.props;
const tien = ngonNgu === 'vi' ? '' : `/${ngonNgu}`;
const nhan = nhanTheBai(bai, ngonNgu, tenTinh);
---

<article class="the-bai the">
  <a href={tien + urlBai(bai)}>
    <Picture ma={bai.anhBia.ma} alt={bai.anhBia.alt} uuTien={uuTien} sizes="(min-width: 1000px) 380px, (min-width: 640px) 50vw, 100vw" />
    <h3>{bai.tieuDe}</h3>
    {nhan.length > 0 && (
      <ul class="nhan-the">
        {nhan.map((n) => <li class="nhan">{n.bieuTuong && <span aria-hidden="true">{n.bieuTuong}</span>}{n.chu}</li>)}
      </ul>
    )}
    <p>{bai.moTa}</p>
  </a>
</article>

<style>
  .the-bai { overflow: hidden; margin: 0; }
  .the-bai a { display: block; color: inherit; text-decoration: none; }
  .the-bai picture img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .the-bai h3 { margin: 12px 16px 8px; font-size: 1.1rem; line-height: 1.35; color: var(--chu); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .nhan-the { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0 16px 8px; padding: 0; }
  .the-bai p { margin: 0 16px 16px; font-size: 0.95rem; color: var(--chu-phu); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (hover: hover) and (min-width: 760px) {
    .the-bai { transition: box-shadow 0.2s, transform 0.2s; }
    .the-bai:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgb(43 36 32 / 0.1); }
  }
</style>
