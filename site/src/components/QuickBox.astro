---
// Khung "Tra nhanh" — phần quan trọng nhất của bài: thông tin tiện lợi hiện trước, kể chuyện để sau.
// Các mục mở rộng dùng <details> của HTML nên bấm mở được mà không cần JavaScript.
// Khối nào không có dữ liệu thì không hiện (bài top-list/cẩm nang có thể không có traNhanh).
import type { BaiViet } from '@vntraveltips/schema';
import { sao } from '../lib/stars';
import { dinhDangTien } from '../lib/giao-dien-b';
import { t as tr } from '../i18n/giao-dien';
import DiaDiemDetails from './DiaDiemDetails.astro';
interface Props {
  bai: BaiViet;
  ngonNgu?: string;
}
const { bai, ngonNgu = 'vi' } = Astro.props;
const t_ = (k: Parameters<typeof tr>[1], p?: Record<string, string | number>) => tr(ngonNgu, k, p);
const t = bai.traNhanh;
const chiPhi = t ? dinhDangTien(t.tongChiPhi, ngonNgu) : '';
const choO = bai.diaDiem.filter((d) => d.kieu === 'cho-o');
const anUong = bai.diaDiem.filter((d) => d.kieu === 'quan-an' || d.kieu === 'cho');
const khac = bai.diaDiem.filter((d) => d.kieu === 'khu-sinh-thai' || d.kieu === 'diem-choi');
---

{
  (t || bai.diaDiem.length > 0) && (
    <section class="tra-nhanh" aria-label={t_('tra-nhanh')}>
      <h2>{t_('tra-nhanh')}</h2>
      {t && (
        <dl>
          <dt>{t_('hop-voi')}</dt><dd>{t.hopVoi}</dd>
          <dt>{t_('thoi-gian')}</dt><dd>{t.thoiGian}</dd>
          {t.choO && (<><dt>{t_('cho-o')}</dt><dd>{t.choO}</dd></>)}
          <dt>{t_('tong-chi-phi')}</dt><dd>{chiPhi} / {t.soNguoi} {t_('nguoi')}</dd>
          <dt>{t_('than-thien-voi-be')}</dt><dd aria-label={t_('sao-tren-5', { n: t.diemThanThienVoiBe })}>{sao(t.diemThanThienVoiBe)}</dd>
          <dt>{t_('di-chuyen')}</dt><dd>{t.diChuyen}</dd>
          <dt>{t_('thoi-diem-nen-di')}</dt><dd>{t.thoiDiemNenDi}</dd>
        </dl>
      )}
      {choO.length > 0 && (
        <details><summary>{t_('cho-o-chi-tiet')}</summary><DiaDiemDetails diaDiem={choO} ngonNgu={ngonNgu} /></details>
      )}
      {anUong.length > 0 && (
        <details><summary>{t_('cho-quan-an', { n: anUong.length })}</summary><DiaDiemDetails diaDiem={anUong} ngonNgu={ngonNgu} /></details>
      )}
      {khac.length > 0 && (
        <details><summary>{t_('diem-tham-quan', { n: khac.length })}</summary><DiaDiemDetails diaDiem={khac} ngonNgu={ngonNgu} /></details>
      )}
      {t && t.luuYVoiBe.length > 0 && (
        <details><summary>{t_('luu-y-voi-be')}</summary><ul>{t.luuYVoiBe.map((l) => <li>{l}</li>)}</ul></details>
      )}
    </section>
  )
}

<style>
  .tra-nhanh { background: #e8f6f5; border: 1px solid var(--vien); border-radius: 12px; padding: 12px 16px; margin: 16px 0; }
  .tra-nhanh h2 { margin: 0 0 8px; font-size: 1.1rem; color: var(--bien); }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 0 0 8px; }
  dt { font-weight: 600; }
  dd { margin: 0; }
  details { border-top: 1px solid var(--vien); padding: 8px 0; }
  summary { cursor: pointer; font-weight: 600; min-height: 32px; }
</style>
