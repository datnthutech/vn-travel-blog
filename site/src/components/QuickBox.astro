---
// Khung "Tra nhanh" — phần quan trọng nhất của bài: thông tin tiện lợi hiện trước, kể chuyện để sau.
// Trình bày dạng lưới ô (emoji + nhãn + giá trị). Các mục mở rộng dùng <details> của HTML nên bấm mở được mà không cần JavaScript.
// Khối nào không có dữ liệu thì không hiện (bài top-list/cẩm nang có thể không có traNhanh).
import type { BaiViet } from '@vntraveltips/schema';
import { sao } from '../lib/stars';
import { dinhDangTien } from '../lib/giao-dien-b';
import { t as tr } from '../i18n/giao-dien';
import DiaDiemDetails from './DiaDiemDetails.astro';
interface Props {
  bai: BaiViet;
  ngonNgu?: string;
}
const { bai, ngonNgu = 'vi' } = Astro.props;
const t_ = (k: Parameters<typeof tr>[1], p?: Record<string, string | number>) => tr(ngonNgu, k, p);
const t = bai.traNhanh;
const chiPhi = t ? dinhDangTien(t.tongChiPhi, ngonNgu) : '';
const choO = bai.diaDiem.filter((d) => d.kieu === 'cho-o');
const anUong = bai.diaDiem.filter((d) => d.kieu === 'quan-an' || d.kieu === 'cho');
const khac = bai.diaDiem.filter((d) => d.kieu === 'khu-sinh-thai' || d.kieu === 'diem-choi');
---

{
  (t || bai.diaDiem.length > 0) && (
    <section class="tra-nhanh" aria-label={t_('tra-nhanh')}>
      <h2><span aria-hidden="true">⚡</span> {t_('tra-nhanh')}</h2>
      {t && (
        <dl class="luoi-tra-nhanh">
          <div class="o"><dt><span aria-hidden="true">👨‍👩‍👧</span> {t_('hop-voi')}</dt><dd>{t.hopVoi}</dd></div>
          <div class="o"><dt><span aria-hidden="true">🗓️</span> {t_('thoi-gian')}</dt><dd>{t.thoiGian}</dd></div>
          {t.choO && (<div class="o"><dt><span aria-hidden="true">🏠</span> {t_('cho-o')}</dt><dd>{t.choO}</dd></div>)}
          <div class="o"><dt><span aria-hidden="true">💰</span> {t_('tong-chi-phi')}</dt><dd>{chiPhi} / {t.soNguoi} {t_('nguoi')}</dd></div>
          <div class="o"><dt><span aria-hidden="true">👶</span> {t_('than-thien-voi-be')}</dt><dd aria-label={t_('sao-tren-5', { n: t.diemThanThienVoiBe })}>{sao(t.diemThanThienVoiBe)}</dd></div>
          <div class="o"><dt><span aria-hidden="true">🚗</span> {t_('di-chuyen')}</dt><dd>{t.diChuyen}</dd></div>
          <div class="o"><dt><span aria-hidden="true">☀️</span> {t_('thoi-diem-nen-di')}</dt><dd>{t.thoiDiemNenDi}</dd></div>
        </dl>
      )}
      {choO.length > 0 && (
        <details><summary><span aria-hidden="true">🏠</span> {t_('cho-o-chi-tiet')}</summary><DiaDiemDetails diaDiem={choO} ngonNgu={ngonNgu} /></details>
      )}
      {anUong.length > 0 && (
        <details><summary><span aria-hidden="true">🍜</span> {t_('cho-quan-an', { n: anUong.length })}</summary><DiaDiemDetails diaDiem={anUong} ngonNgu={ngonNgu} /></details>
      )}
      {khac.length > 0 && (
        <details><summary><span aria-hidden="true">📍</span> {t_('diem-tham-quan', { n: khac.length })}</summary><DiaDiemDetails diaDiem={khac} ngonNgu={ngonNgu} /></details>
      )}
      {t && t.luuYVoiBe.length > 0 && (
        <details><summary><span aria-hidden="true">⚠️</span> {t_('luu-y-voi-be')}</summary><ul>{t.luuYVoiBe.map((l) => <li>{l}</li>)}</ul></details>
      )}
    </section>
  )
}

<style>
  .tra-nhanh { margin: 16px 0; padding: 16px; background: var(--nen-tra-nhanh); border: 1px solid var(--vien-tra-nhanh); border-radius: var(--bo); }
  .tra-nhanh h2 { margin: 0 0 12px; font-size: 1.15rem; color: var(--nhan-dam); }
  .luoi-tra-nhanh { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 0 0 8px; }
  .o { padding: 10px 12px; background: #fff; border-radius: 12px; }
  .o dt { font-size: 0.82rem; font-weight: 600; color: var(--chu-phu); }
  .o dd { margin: 2px 0 0; font-weight: 700; }
  /* Ô cuối lẻ kéo hết hàng để lưới không bị hụt. */
  .luoi-tra-nhanh .o:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 640px) {
    .luoi-tra-nhanh { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .luoi-tra-nhanh .o:last-child:nth-child(odd) { grid-column: auto; }
    .luoi-tra-nhanh .o:last-child:nth-child(3n + 1) { grid-column: 1 / -1; }
  }
  details { border-top: 1px solid var(--vien-tra-nhanh); padding: 4px 0; }
  summary { display: flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 700; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '▾'; margin-left: auto; transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(180deg); }
</style>
