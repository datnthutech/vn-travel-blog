---
// Trang chủ tiếng Việt: nội dung dựng ở components/TrangChu.astro, dùng chung với trang chủ ngôn ngữ phụ.
import Base from '../layouts/Base.astro';
import TrangChu from '../components/TrangChu.astro';
import { layBaiViet, layTinh } from '../lib/bai';
import { SITE } from '../config/site';
const [bai, tinh] = await Promise.all([layBaiViet(), layTinh()]);
---

<Base title={`${SITE.ten} — nhật ký du lịch gia đình`} moTa={SITE.moTa}>
  <TrangChu ngonNgu="vi" bai={bai} tinh={tinh} />
</Base>
