---
// Câu hỏi thường gặp. Không có FAQ thì không hiện gì.
import { t } from '../i18n/giao-dien';
interface Props {
  faq: { hoi: string; dap: string }[];
  ngonNgu?: string;
}
const { faq, ngonNgu = 'vi' } = Astro.props;
---

{
  faq.length > 0 && (
    <section class="the khoi">
      <h2>{t(ngonNgu, 'faq')}</h2>
      {faq.map((f) => <details><summary>{f.hoi}</summary><p>{f.dap}</p></details>)}
    </section>
  )
}

<style>
  .khoi { margin: 24px 0; padding: 16px; }
  h2 { margin: 0 0 8px; font-size: 1.2rem; }
  details { border-top: 1px solid var(--vien); padding: 4px 0; }
  summary { display: flex; align-items: center; min-height: 44px; font-weight: 700; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '▾'; margin-left: auto; transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(180deg); }
  details p { margin: 0 0 8px; }
</style>
