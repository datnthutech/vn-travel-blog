---
// Danh sách địa điểm (chỗ ở / quán ăn / điểm chơi) nằm trong một mục mở rộng của khung Tra nhanh.
import type { DiaDiem } from '@vntraveltips/schema';
import { sao } from '../lib/stars';
import Picture from './Picture.astro';
import { REL_AFFILIATE } from '../lib/affiliate';
interface Props {
  diaDiem: DiaDiem[];
}
const { diaDiem } = Astro.props;
---

<ul class="dia-diem">
  {
    diaDiem.map((d) => (
      <li>
        {d.anh[0] && <Picture ma={d.anh[0].ma} alt={d.anh[0].alt} sizes="(min-width: 800px) 360px, 100vw" />}
        <strong>{d.ten}</strong>
        {d.diem && <span class="sao"> {sao(d.diem)}</span>}
        {d.khoangGia && <div>Giá: {d.khoangGia}</div>}
        {d.gioMoCua && <div>Giờ mở cửa: {d.gioMoCua}</div>}
        {d.diaChi && <div>Địa chỉ: {d.diaChi}</div>}
        {d.thanThienVoiBe && <div>Với bé: {d.thanThienVoiBe}</div>}
        {d.uuDiem.length > 0 && <div>Ưu điểm: {d.uuDiem.join(', ')}</div>}
        {d.nhuocDiem.length > 0 && <div>Nhược điểm: {d.nhuocDiem.join(', ')}</div>}
        {d.linkDat && (
          <a class="nut-dat" href={d.linkDat.url} rel={REL_AFFILIATE} target="_blank">
            Đặt qua {d.linkDat.nhaCungCap}
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  .dia-diem { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 12px; }
  .sao { color: #e6a700; }
  .nut-dat { display: inline-block; margin-top: 6px; padding: 8px 14px; background: var(--ngoc); color: #fff; border-radius: 8px; text-decoration: none; }
</style>
