---
// Trang chuyên mục: /chu-de/[chuyen-muc]/ — chỉ tạo cho chuyên mục đã có bài.
import DanhSachBai from '../../components/DanhSachBai.astro';
import { layBaiViet, layTinh } from '../../lib/bai';
import { layChuyenMuc } from '../../lib/chuyen-muc';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const bai = await layBaiViet();
  return layChuyenMuc()
    .map((cm) => ({ params: { chuyenMuc: cm.slug }, props: { cm, bai: bai.filter((b) => b.chuyenMuc.includes(cm.slug)) } }))
    .filter((p) => p.props.bai.length > 0);
}
const { cm, bai } = Astro.props;
const ten = cm.ten;
const tenTinhCua = new Map((await layTinh()).map((x) => [x.slug, x.ten]));
---

<DanhSachBai
  title={`${ten} — ${SITE.ten}`}
  tieuDe={ten}
  moTa={cm.moTa || `Các bài về ${ten.toLowerCase()} khi đi du lịch cùng bé nhỏ.`}
  bai={bai}
  tenTinh={(s) => tenTinhCua.get(s)}
/>
