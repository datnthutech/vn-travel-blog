---
// Danh sách địa điểm (chỗ ở / quán ăn / điểm chơi) nằm trong một mục mở rộng của khung Tra nhanh.
import type { DiaDiem } from '@vntraveltips/schema';
import { sao } from '../lib/stars';
import Picture from './Picture.astro';
import { REL_AFFILIATE } from '../lib/affiliate';
import { t } from '../i18n/giao-dien';
interface Props {
  diaDiem: DiaDiem[];
  ngonNgu?: string;
}
const { diaDiem, ngonNgu = 'vi' } = Astro.props;
---

<ul class="dia-diem">
  {
    diaDiem.map((d) => (
      <li>
        {d.anh[0] && <Picture ma={d.anh[0].ma} alt={d.anh[0].alt} sizes="(min-width: 800px) 360px, 100vw" />}
        <strong>{d.ten}</strong>
        {d.diem && <span class="sao"> {sao(d.diem)}</span>}
        {d.khoangGia && <div>{t(ngonNgu, 'gia')}: {d.khoangGia}</div>}
        {d.gioMoCua && <div>{t(ngonNgu, 'gio-mo-cua')}: {d.gioMoCua}</div>}
        {d.diaChi && <div>{t(ngonNgu, 'dia-chi')}: {d.diaChi}</div>}
        {d.thanThienVoiBe && <div>{t(ngonNgu, 'voi-be')}: {d.thanThienVoiBe}</div>}
        {d.uuDiem.length > 0 && <div>{t(ngonNgu, 'uu-diem')}: {d.uuDiem.join(', ')}</div>}
        {d.nhuocDiem.length > 0 && <div>{t(ngonNgu, 'nhuoc-diem')}: {d.nhuocDiem.join(', ')}</div>}
        {d.linkDat && (
          <a class="nut-dat" href={d.linkDat.url} rel={REL_AFFILIATE} target="_blank">
            {t(ngonNgu, 'dat-qua', { ncc: d.linkDat.nhaCungCap })}
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  .dia-diem { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 12px; }
  .sao { color: #e6a700; }
  .nut-dat { display: inline-block; margin-top: 6px; padding: 8px 14px; background: var(--ngoc); color: #fff; border-radius: 8px; text-decoration: none; }
</style>
