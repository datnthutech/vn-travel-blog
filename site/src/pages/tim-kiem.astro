---
// Tìm kiếm tĩnh bằng Pagefind: chỉ mục được sinh sau `astro build` (xem script build), chạy hoàn toàn ở trình duyệt.
// Lúc `npm run dev` chưa có chỉ mục, trang hiện thông báo thay vì lỗi.
import Base from '../layouts/Base.astro';
---

<Base title="Tìm kiếm — VNTravelTips">
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <section class="dai-tieu-de">
    <h1>Tìm kiếm</h1>
  </section>
  <div id="tim-kiem"></div>
  <noscript>Cần bật JavaScript để dùng tìm kiếm.</noscript>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    if (window.PagefindUI) {
      new PagefindUI({ element: '#tim-kiem', showSubResults: false, translations: { placeholder: 'Tìm bài viết…' } });
    } else {
      document.getElementById('tim-kiem').textContent = 'Tìm kiếm chỉ hoạt động trên bản đã build.';
    }
  </script>
</Base>

<style is:global>
  /* Pagefind dùng biến CSS này: đưa ô tìm và kết quả về cùng tông với giao diện B. */
  :root {
    --pagefind-ui-primary: #c0501c;
    --pagefind-ui-border: #f0e3d3;
    --pagefind-ui-background: #fff;
    --pagefind-ui-border-radius: 14px;
    --pagefind-ui-font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
</style>
