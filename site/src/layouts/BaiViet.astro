---
// Trang bài viết — mẫu B "Bảng tra nhanh + mục mở rộng". Thứ tự từ trên xuống theo thiết kế mục 7:
// ảnh bìa & tiêu đề → Tra nhanh → mục lục → nội dung → đồ cho bé / FAQ / liên quan.
// Cả hai route (/[tinh]/[slug]/ và /kinh-nghiem/[slug]/) dùng chung layout này.
import { render, type CollectionEntry } from 'astro:content';
import { urlBai, type BaiViet, type Tinh } from '@vntraveltips/schema';
import { jsonLd } from '../lib/jsonld';
import Base from './Base.astro';
import Picture from '../components/Picture.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuickBox from '../components/QuickBox.astro';
import Toc from '../components/Toc.astro';
import DoChoBe from '../components/DoChoBe.astro';
import Faq from '../components/Faq.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import AdSlot from '../components/AdSlot.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import BinhLuan from '../components/BinhLuan.astro';
import DangKyBanTin from '../components/DangKyBanTin.astro';
import { coAffiliate } from '../lib/affiliate';
import { breadcrumb } from '../lib/breadcrumb';
import { layBaiViet } from '../lib/bai';
import { related } from '../lib/related';
import { nhanDauBai } from '../lib/giao-dien-b';
import { t } from '../i18n/giao-dien';

interface Props {
  bai: BaiViet;
  entry: CollectionEntry<'bai-viet'>;
  tinh?: Tinh;
  ngonNgu?: string;
}
const { bai, entry, tinh, ngonNgu = 'vi' } = Astro.props;
const tien = ngonNgu === 'vi' ? '' : `/${ngonNgu}`;
// hreflang: trang này + các bản đã đăng khác (xuatNoiDung ghi `banDich`). Bài chỉ có một ngôn ngữ → rỗng (không sinh thẻ thừa).
const hreflang = bai.banDich && Object.keys(bai.banDich).length > 0 ? { [ngonNgu]: tien + urlBai(bai), ...bai.banDich } : {};
const { Content, headings } = await render(entry);
const lienQuan = related(bai, await layBaiViet(ngonNgu));
const ngay = (d?: Date) => d?.toLocaleDateString(ngonNgu === 'vi' ? 'vi-VN' : ngonNgu);
const phut = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 200));
const nhan = nhanDauBai(bai, ngonNgu, tinh?.ten);
---

<Base
  title={bai.tieuDe}
  ngonNgu={ngonNgu}
  hreflang={hreflang}
  moTa={bai.moTa}
  duongDan={tien + urlBai(bai)}
  anh={`/anh/${bai.anhBia.ma}/1600.webp`}
  loai="article"
  jsonLd={jsonLd(bai, { site: Astro.site!.toString(), tinh, ngonNgu })}
>
  <article data-pagefind-body>
    <Picture ma={bai.anhBia.ma} alt={bai.anhBia.alt} uuTien />
    <Breadcrumb muc={breadcrumb(bai, tinh, ngonNgu)} />
    <h1>{bai.tieuDe}</h1>
    <ul class="nhan-dau-bai">
      {nhan.map((n) => <li class="nhan">{n.bieuTuong && <span aria-hidden="true">{n.bieuTuong}</span>}{n.chu}</li>)}
    </ul>
    <p class="meta">
      {bai.ngayDi && <>{t(ngonNgu, 'di-ngay')} {ngay(bai.ngayDi)} · </>}
      {bai.ngayCapNhat && <>{t(ngonNgu, 'cap-nhat')} {ngay(bai.ngayCapNhat)} · </>}
      {phut} {t(ngonNgu, 'phut-doc')}
      {bai.hopTac && <span class="nhan">{t(ngonNgu, 'bai-hop-tac')}</span>}
    </p>
    <QuickBox bai={bai} ngonNgu={ngonNgu} />
    <AdSlot viTri="sauTraNhanh" />
    <Toc headings={headings} ngonNgu={ngonNgu} />
    <div class="noi-dung"><Content /></div>
    <AdSlot viTri="giuaBai" />
    <DoChoBe doMang={bai.doMangChoBe} ngonNgu={ngonNgu} />
    <Faq faq={bai.faq} ngonNgu={ngonNgu} />
    <RelatedPosts bai={lienQuan} ngonNgu={ngonNgu} />
    <AdSlot viTri="cuoiBai" />
    {coAffiliate(bai) && <AffiliateDisclosure ngonNgu={ngonNgu} />}
    <DangKyBanTin ngonNgu={ngonNgu} />
    <BinhLuan maBai={bai.maBai} ngonNgu={ngonNgu} />
  </article>
</Base>

<style>
  /* Cột đọc hẹp (760 px) cho cả đầu bài và thân bài; ảnh bìa vẫn lấp đầy cột. */
  article { max-width: var(--rong-bai); margin: 0 auto; }
  /* Ảnh bìa dạng băng ngang như mẫu (ảnh dọc/4:3 không chiếm cả màn hình); width/height vẫn có → không nhảy trang. */
  article > :global(picture:first-child img) { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--bo); }
  .nhan-dau-bai { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 8px 0 0; padding: 0; }
  .meta { margin: 12px 0 0; color: var(--chu-phu); font-size: 0.9rem; }
  .meta .nhan { margin-left: 8px; }
  .noi-dung { font-size: 1.0625rem; line-height: 1.7; }
  .noi-dung :global(img) { border-radius: 10px; }
  .noi-dung :global(h2) { margin-top: 1.8em; }
</style>
